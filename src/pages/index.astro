---
import BaseLayout from "../layouts/BaseLayout.astro";
import probe from "../data/probe.json";

const families = [...new Set(probe.tools.map((tool) => tool.family))].length;
const checkedAt = new Date(probe.source.fetchedAt).toLocaleDateString("en-GB", { dateStyle: "long", timeZone: "UTC" });
---

<BaseLayout
  title="GitHub Actions runner software versions — Runner Image Index"
  description="Search 30 CI tools and compare the versions listed across official GitHub-hosted runner image manifests."
  canonicalPath="/"
>
  <section class="intro" aria-labelledby="page-title">
    <div>
      <p class="eyebrow">Official manifests, inverted</p>
      <h1 id="page-title">What’s installed on GitHub Actions runners?</h1>
      <p class="lede">Search by tool instead of scanning image-by-image manifests. Every version links back to the exact official source revision.</p>
    </div>
    <dl class="stats" aria-label="Dataset summary">
      <div><dt>Tools</dt><dd>{probe.probe.toolPageCount}</dd></div>
      <div><dt>Images</dt><dd>{probe.tools[0]?.totalImageCount ?? 0}</dd></div>
      <div><dt>Families</dt><dd>{families}</dd></div>
      <div><dt>Synced</dt><dd>{checkedAt}</dd></div>
    </dl>
  </section>

  <section class="tool-browser" aria-labelledby="browse-title">
    <div class="browser-heading">
      <div>
        <p class="eyebrow">30-page Probe</p>
        <h2 id="browse-title">Find a tool</h2>
      </div>
      <label class="search-field">
        <span class="sr-only">Filter tools</span>
        <input id="tool-search" type="search" placeholder="Search Docker, Python, kubectl…" autocomplete="off" />
        <kbd>/</kbd>
      </label>
    </div>

    <p id="empty-state" class="empty-state" hidden>No selected tool matches that search.</p>
    <div class="tool-grid" id="tool-grid">
      {probe.tools.map((tool) => {
        const listed = tool.availability.filter((row) => row.available);
        const osNames = [...new Set(listed.map((row) => row.operatingSystem))];
        return (
          <a class="tool-card" href={`/tools/${tool.slug}/`} data-tool={`${tool.canonicalName} ${tool.aliases.join(" ")} ${tool.family}`.toLowerCase()}>
            <span class="tool-family">{tool.family.replaceAll("-", " ")}</span>
            <h3>{tool.canonicalName}</h3>
            <p>Listed on <strong>{tool.listedImageCount}</strong> of {tool.totalImageCount} images</p>
            <span class="os-list">{osNames.join(" · ")}</span>
          </a>
        );
      })}
    </div>
  </section>

  <section class="source-note" aria-labelledby="source-title">
    <p class="eyebrow">Data boundary</p>
    <h2 id="source-title">A manifest index, not a compatibility promise</h2>
    <p>“Listed” means the tool and version appear in the official manifest at revision <code>{probe.source.commit.slice(0, 12)}</code>. A workflow using a moving <code>-latest</code> label can temporarily receive another image during GitHub’s staged rollout. Check the <em>Set up job</em> log when an exact build environment matters.</p>
    <a class="text-link" href="/methodology/">Read the methodology and limitations →</a>
  </section>
</BaseLayout>

<script>
  const input = document.querySelector<HTMLInputElement>("#tool-search");
  const cards = [...document.querySelectorAll<HTMLElement>("[data-tool]")];
  const empty = document.querySelector<HTMLElement>("#empty-state");
  const filter = () => {
    const query = input?.value.trim().toLowerCase() ?? "";
    let visible = 0;
    for (const card of cards) {
      const match = card.dataset.tool?.includes(query) ?? false;
      card.hidden = !match;
      if (match) visible += 1;
    }
    if (empty) empty.hidden = visible !== 0;
  };
  input?.addEventListener("input", filter);
  document.addEventListener("keydown", (event) => {
    if (event.key === "/" && document.activeElement !== input) {
      event.preventDefault();
      input?.focus();
    }
  });
</script>
